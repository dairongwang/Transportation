# =====================================================================================
# ServiceUber ADMIN DASHBOARD - environment template.  cp .env.example .env
# A separate application: its own secrets, database and port. Every secret below is a
# FAKE "DUMMY" value; ADMIN_ENV=production refuses them.
# =====================================================================================
ADMIN_ENV=development                    # development | production | testing
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5001
# Signs the dashboard's session cookie (uber_admin_session). Generate a real one for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=DUMMY_ADMIN_SECRET_KEY_CHANGE_ME
# The dashboard's OWN database (operators + audit log), inside admin_dashboard/instance/.
ADMIN_DATABASE_URL=sqlite:///uber_admin.db

# ---- the ServiceUber app's Admin API (the only connection between the two applications)
MAIN_APP_API_URL=http://127.0.0.1:5000/admin-api/v1
# Must equal ADMIN_API_TOKEN in the ServiceUber app's .env
MAIN_APP_API_TOKEN=DUMMY_ADMIN_API_TOKEN
MAIN_APP_API_TIMEOUT=10

# ---- sessions / sign-in
ADMIN_SESSION_COOKIE_SECURE=false        # true behind HTTPS (forced in production)
ADMIN_SESSION_LIFETIME_SECONDS=28800
ADMIN_LOGIN_MAX_FAILED=5
ADMIN_LOCKOUT_SECONDS=900
ADMIN_PASSWORD_MIN_LENGTH=12
# Seed DUMMY operators (dummy_manager / dummyManagerPass123, dummy_viewer / dummyViewerPass123)
# when the dashboard has no users yet. Forced off in production: use manage.py create-user.
ADMIN_SEED_DEMO_USERS=true
# Live updates: relay ServiceUber's event stream (/admin-api/v1/events) to the browsers, so pages
# update without a refresh when reports / disputes change or another manager decides.
ADMIN_LIVE_UPDATES=true
