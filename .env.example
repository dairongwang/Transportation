# =====================================================================================
# ServiceUber - environment template.            cp .env.example .env
#                                                 (Windows: copy .env.example .env)
# The launchers (run.sh / run.bat / run.ps1) copy this file to .env automatically.
#
# EVERY secret, token, key, username and password below is a FAKE "DUMMY" value so the
# app starts immediately for local development and testing. APP_ENV=production refuses
# any DUMMY value (see config.py -> ProductionConfig).
# No real credit-card numbers or phone numbers are needed anywhere: the payment gateway,
# SMS, e-mail, OAuth and background-check providers are all offline fakes by default.
# =====================================================================================

# ------------------------------------------------------------------------------ core
APP_ENV=development                      # development | production | testing
DEBUG=true                               # development only: Werkzeug debugger + auto-reload (false for load tests)
APP_NAME=ServiceUber
HOST=127.0.0.1                           # 0.0.0.0 = reachable from phones/tablets on your LAN
PORT=5000
# HTTPS=1                                # self-signed cert (lets phones on the LAN share GPS)
# Public base URL used in e-mails (password-reset links). Empty = the request host.
APP_BASE_URL=
# Number of reverse proxies in front of the app (for correct client IPs). 0 = none.
BEHIND_PROXY=0

# REQUIRED. Signs the session cookie + CSRF tokens. Real value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=DUMMY_FLASK_SECRET_KEY_CHANGE_ME
# REQUIRED. Encrypts authenticator secrets / payment token ids / background-check PII and
# keys the HMACs of one-time codes. Real value for production (32 random bytes, base64):
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
MFA_ENCRYPTION_KEY=DUMMY_MFA_ENCRYPTION_KEY_CHANGE_ME
# Comma-separated OLD keys still accepted for decryption during a rotation
# (then run: python scripts/rotate_keys.py).
MFA_ENCRYPTION_KEY_PREVIOUS=

# SQLite file inside ./instance/ (created automatically). Any SQLAlchemy URL works.
DATABASE_URL=sqlite:///uber_services.db
# SQLite under concurrent load (threads / several worker processes) - see dbtuning.py:
SQLITE_WAL=true                          # WAL journal: readers never block the writer
SQLITE_BUSY_TIMEOUT_MS=15000             # a writer waits this long for the lock instead of failing
SQLITE_WRITE_LOCK=true                   # queue writers on an OS file lock (POSIX) instead of sleeping

# ------------------------------------------------------------------------- dev tools
# /dev/outbox (fake inbox), /dev/env, driver-bot simulator, fake Stripe/PayPal/OAuth pages.
# Forced OFF in production.
ENABLE_DEV_TOOLS=true
# Seeds DUMMY accounts (dummy_buyer / dummy_seller / dummy_driver_1..8) on an empty database.
SEED_DEMO_DATA=true

# ------------------------------------------------------------------ sessions / passwords
SESSION_COOKIE_SECURE=false              # true behind HTTPS (forced in production)
SESSION_LIFETIME_SECONDS=43200
PASSWORD_MIN_LENGTH=10
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_MAX_PER_HOUR=3

# ------------------------------------------------------------- two-factor authentication
OTP_CODE_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=6
MFA_PENDING_TTL_SECONDS=300
TRUSTED_DEVICE_DAYS=30

# ------------------------------------------------------- brute-force protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://          # redis://localhost:6379/0 for several workers
RATELIMIT_LOGIN=15 per minute;100 per hour
RATELIMIT_2FA=20 per minute;100 per hour
RATELIMIT_REGISTER=5 per minute;30 per hour
RATELIMIT_RESET=5 per minute;20 per hour
RATELIMIT_CODE_SEND=5 per minute;30 per hour

# CAPTCHA: none | dummy (offline arithmetic challenge) | turnstile | hcaptcha | recaptcha
CAPTCHA_PROVIDER=dummy
CAPTCHA_SITE_KEY=DUMMY_CAPTCHA_SITE_KEY
CAPTCHA_SECRET_KEY=DUMMY_CAPTCHA_SECRET_KEY
CAPTCHA_AFTER_FAILURES=3
CAPTCHA_WINDOW_MINUTES=15

# ------------------------------------------------------------ e-mail / SMS delivery
# console -> codes are printed in the terminal AND shown at /dev/outbox (no real sending)
# memory  -> /dev/outbox only        smtp / twilio -> real delivery (see scripts/fake_*_server.py)
EMAIL_BACKEND=console
SMS_BACKEND=console
AUTH_OUTBOX_PATH=auth_outbox.jsonl
MAIL_FROM=dummy_no-reply@serviceuber.example
SMTP_HOST=127.0.0.1
SMTP_PORT=2525                           # scripts/fake_smtp_server.py listens here
SMTP_USE_TLS=false
SMTP_USE_AUTH=false
SMTP_USERNAME=DUMMY_SMTP_USER
SMTP_PASSWORD=DUMMY_SMTP_PASSWORD
TWILIO_ACCOUNT_SID=DUMMY_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=DUMMY_TWILIO_AUTH_TOKEN
# Fictional sender: +1-555-01xx numbers are reserved for fiction and never ring anyone.
TWILIO_FROM_NUMBER=+15550100000
TWILIO_API_BASE=https://api.twilio.com   # http://127.0.0.1:8089 = scripts/fake_twilio_server.py

# -------------------------------------------------------------- social login (OAuth)
# fake -> the app hosts a stub identity provider at /dev/oauth/... (needs ENABLE_DEV_TOOLS)
OAUTH_MODE=fake
OAUTH_PROVIDERS=google,apple,facebook
# Empty = the in-app stub. http://127.0.0.1:8090 = scripts/fake_oauth_server.py instead.
OAUTH_FAKE_BASE_URL=
OAUTH_GOOGLE_CLIENT_ID=DUMMY_GOOGLE_CLIENT_ID.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=DUMMY_GOOGLE_CLIENT_SECRET
OAUTH_FACEBOOK_APP_ID=DUMMY_FACEBOOK_APP_ID
OAUTH_FACEBOOK_APP_SECRET=DUMMY_FACEBOOK_APP_SECRET
OAUTH_APPLE_CLIENT_ID=DUMMY_APPLE_SERVICE_ID
OAUTH_APPLE_TEAM_ID=DUMMY_APPLE_TEAM_ID
OAUTH_APPLE_KEY_ID=DUMMY_APPLE_KEY_ID
OAUTH_APPLE_PRIVATE_KEY=DUMMY_APPLE_PRIVATE_KEY_PEM
FAKE_OAUTH_SIGNING_KEY=DUMMY_FAKE_OAUTH_SIGNING_KEY

# ------------------------------------------------------------------------- payments
# fake -> offline gateway + card vault with public test cards (e.g. 4242 4242 4242 4242).
PAYMENTS_MODE=fake
PAYMENT_CURRENCY=USD
PAYMENT_GATEWAY_KEY=DUMMY_PAYMENT_KEY
STRIPE_PUBLISHABLE_KEY=DUMMY_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=DUMMY_STRIPE_SECRET_KEY
PAYPAL_CLIENT_ID=DUMMY_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=DUMMY_PAYPAL_CLIENT_SECRET
FAKE_VAULT_SIGNING_KEY=DUMMY_FAKE_VAULT_SIGNING_KEY
TOKENIZATION_URL=/dev/payments/tokenize  # where the BROWSER sends card data (never our server)
PAYMENT_METHODS_MAX=10
PAYMENT_VALIDATION_AMOUNT=1.00
RIDE_PREAUTH_FACTOR=1.5                  # hold = driver's quote x 1.5 when the rider orders

# ------------------------------------------------------------------- ride matching
MAPS_BACKEND=stub                        # offline geocoder/router for the demo city
MAPS_API_KEY=DUMMY_MAPS_API_KEY
JWT_SECRET=DUMMY_JWT_SECRET
RIDE_SEARCH_RADIUS_KM=10
RIDE_MAX_CANDIDATES=8                    # drivers listed / offered per ride
RIDE_CANDIDATE_POOL=40                   # score only the N nearest drivers (0 = all within the radius)
RIDE_DRIVER_INDEX_TTL_SECONDS=2          # in-memory driver index per worker (rides/driver_index.py)
RIDE_OFFER_TTL_SECONDS=120
RIDE_SWEEP_INTERVAL_SECONDS=10
# Live updates (SSE) with several worker processes: unix = share events between the processes of
# this host (rides/bus.py); local = one process only (the dev server, or gunicorn -w 1).
EVENT_BUS=local
EVENT_BUS_DIR=                           # empty = instance/eventbus
DRIVER_LOCATION_STALE_SECONDS=1800
RIDE_RANK_WEIGHT_DISTANCE=0.40
RIDE_RANK_WEIGHT_RATING=0.25
RIDE_RANK_WEIGHT_PRICE=0.20
RIDE_RANK_WEIGHT_ACCEPTANCE=0.15

# --------------------------------------------------------- rider <-> driver chat
# A chat room opens when the rider places the order; it closes when the ride ends.
RIDE_CHAT_MAX_LENGTH=500                 # characters per message
RIDE_CHAT_HISTORY_LIMIT=200              # messages loaded per room
RIDE_CHAT_RATE_LIMIT=20 per minute       # messages per logged-in user
# Dev tools only: demo driver bots answer chat messages with a canned reply.
RIDE_CHAT_BOT_REPLIES=true

# --------------------------------------------------------------- background checks
BACKGROUND_CHECK_REQUIRED=true
BACKGROUND_CHECK_PROVIDER=fake           # offline stub; see /dev/background (Provider (dev))
BACKGROUND_CHECK_API_KEY=DUMMY_BACKGROUND_CHECK_API_KEY
BACKGROUND_CHECK_WEBHOOK_SECRET=DUMMY_BACKGROUND_CHECK_WEBHOOK_SECRET
BACKGROUND_CHECK_VALID_DAYS=365
BACKGROUND_CHECK_MIN_AGE=18
BACKGROUND_CHECK_MIN_DRIVER_AGE=21
BACKGROUND_CHECK_MAX_DISPUTES=1

# ------------------------------------------------ admin API (for admin_dashboard/)
ADMIN_API_ENABLED=true
# Must equal MAIN_APP_API_TOKEN in admin_dashboard/.env
ADMIN_API_TOKEN=DUMMY_ADMIN_API_TOKEN
ADMIN_DASHBOARD_URL=http://127.0.0.1:5001
